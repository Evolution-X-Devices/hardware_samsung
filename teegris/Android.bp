cc_binary {
    name: "hermesd",
    required: ["hermesd.rc"],
    shared_libs: ["libteecl_link_stub"],
    header_libs: ["libteecl_headers"],
    srcs: ["hermes.c"],
    vendor: true,
}

prebuilt_etc {
    name: "hermesd.rc",
    src: "hermesd.rc",
    filename: "hermesd-oss.rc",
    sub_dir: "init",
    vendor: true,
}

cc_library_headers {
    name: "libteecl_headers",
    export_include_dirs: ["."],
}

cc_library_shared {
    name: "libteecl_link_stub",
    stem: "libteecl",
    srcs: ["teecl_stub.c"],
    installable: false,
    vendor: true,
}
